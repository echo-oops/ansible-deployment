#!/bin/bash
# Simple healthcheck script generated by Ansible
URL="{{ monitoring_health_url }}"
LOG="{{ monitoring_log }}"
RETRIES="{{ monitoring_retries }}"
DELAY="{{ monitoring_delay }}"

for i in $(seq 1 $RETRIES); do
  status=$(curl -s -o /dev/null -w "%{http_code}" "$URL" || echo "000")
  if [ "$status" = "{{ healthcheck.expected_status | default(200) }}" ]; then
    echo "$(date -Iseconds) OK $URL ($status)" >> "$LOG"
    exit 0
  else
    echo "$(date -Iseconds) FAIL $URL ($status) attempt $i" >> "$LOG"
    sleep $DELAY
  fi
done

exit 1
